{
  "version": 2,
  "buildCommand": "node node_modules/prisma/bin/prisma.js generate --schema src/prisma/schema.prisma && tsc",
  "builds": [
    {
      "src": "dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/index.js"
    }
  ]
}